# paper2code 专用 API Key 模板
# =============================================================================
# 用法：复制本文件为 configs/api_keys.yaml，填入真实 Key，然后重启服务。
#       configs/api_keys.yaml 已被 .gitignore 忽略，切勿提交到公开仓库。
#
# 优先级：命令行参数 > 环境变量 > configs/api_keys.yaml > configs/default.yaml
#
# 留空 llm_api_key 时自动走离线规则引擎，上传 PDF → 生成课件/播客/复现仍然可用。
# 填入 Key 后会自动从 offline 升级为 openai 兼容模式。
# =============================================================================

# --- 大模型（LLM）---
# DeepSeek 示例：
llm_base_url: https://api.deepseek.com/v1
llm_api_key: ""
llm_model: deepseek-chat

# OpenAI 示例（改完上面三行即可）：
# llm_base_url: https://api.openai.com/v1
# llm_api_key: "sk-xxxxxxxx"
# llm_model: gpt-4o-mini

# --- 语音合成（TTS，可选）---
# 填了 tts_api_key 后，播客优先走 SiliconFlow（OpenAI 兼容 POST /v1/audio/speech）。
# 也可以不写文件，改用环境变量 P2C_TTS_API_KEY（以及 P2C_TTS_BASE_URL / P2C_TTS_MODEL /
# P2C_TTS_VOICE / P2C_TTS_VOICE_ALT / P2C_TTS_PROVIDER）。
# 无 Key，或云端调用失败时，自动回退 edge-tts → Windows SAPI → 静音占位。
#
# CosyVoice2-0.5B 系统预置音色（须加模型前缀）：
#   男声 alex（沉稳） benjamin（低沉） charles（磁性） david（明快）
#   女声 anna（沉稳） bella（热情） claire（温柔） diana（明快）
# 默认主持人 alex、讲解人 anna，两人音色不同。
tts_provider: auto
tts_base_url: https://api.siliconflow.cn/v1
tts_api_key: ""
tts_model: FunAudioLLM/CosyVoice2-0.5B
tts_voice: "FunAudioLLM/CosyVoice2-0.5B:alex"
tts_voice_alt: "FunAudioLLM/CosyVoice2-0.5B:anna"
